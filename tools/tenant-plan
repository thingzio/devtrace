#!/bin/bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${DIR}/common"

has_tools curl jq

usage() {
    echo "Usage: $0 <username> <plan>"
    echo ""
    echo "Plans:"
    echo "  free        50 contributors/month"
    echo "  starter     200 contributors/month"
    echo "  pro         2,000 contributors/month"
    exit 1
}

[[ $# -ne 2 ]] && usage

USERNAME="$1"
PLAN="$2"

case "$PLAN" in
    free|starter|pro) ;;
    *) err "Unknown plan: $PLAN (must be free, starter, or pro)" ;;
esac

DEVTRACE_API_URL="${DEVTRACE_API_URL:-http://localhost:8080}"
DEVTRACE_ADMIN_API_KEY="${DEVTRACE_ADMIN_API_KEY:?DEVTRACE_ADMIN_API_KEY is required}"

msg "Updating ${USERNAME} to plan ${PLAN}..."
RESPONSE="$(curl -s -w "\n%{http_code}" \
    -X PUT \
    -H "Authorization: Bearer ${DEVTRACE_ADMIN_API_KEY}" \
    -H "Content-Type: application/json" \
    -d "{\"plan\":\"${PLAN}\"}" \
    "${DEVTRACE_API_URL}/api/v1/admin/tenant/${USERNAME}/plan")"

HTTP_CODE="$(echo "${RESPONSE}" | tail -1)"
BODY="$(echo "${RESPONSE}" | sed '$d')"

if [[ "${HTTP_CODE}" != "200" ]]; then
    err "Failed (HTTP ${HTTP_CODE}): ${BODY}"
fi

echo "${BODY}" | jq .
msg "Done."
