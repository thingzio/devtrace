#!/bin/bash
set -euo pipefail

err() { echo "FAIL: $*" >&2; FAILURES=$((FAILURES + 1)); }
pass() { echo "PASS: $*"; }

command -v go >/dev/null 2>&1 || { echo "FAIL: go is required" >&2; exit 1; }
command -v curl >/dev/null 2>&1 || { echo "FAIL: curl is required" >&2; exit 1; }

TMPDIR_E2E=$(mktemp -d)
SITE_PID=""
STARTED_COMPOSE=false
cleanup() {
  [[ -n "$SITE_PID" ]] && kill "$SITE_PID" 2>/dev/null
  [[ "$STARTED_COMPOSE" == "true" ]] && docker compose down 2>/dev/null
  rm -rf "$TMPDIR_E2E"
}
trap cleanup EXIT

FAILURES=0
DEV_DB="${DATABASE_URL:-postgres://devtrace:devtrace@localhost:5432/devtrace?sslmode=disable}"
SITE_PORT=18080

# ==========================================================================
# Build
# ==========================================================================
echo "==> Building devtrace-site..."
SITE="$TMPDIR_E2E/devtrace-site"
go build -mod=vendor -o "$SITE" ./cmd/devtrace-site
[[ -x "$SITE" ]] || { echo "FAIL: devtrace-site binary not found" >&2; exit 1; }


# ==========================================================================
# Smoke tests (no DB)
# ==========================================================================
if output=$(DATABASE_URL="postgres://bad:bad@localhost:1/bad?sslmode=disable&connect_timeout=1" "$SITE" 2>&1); then
  err "site-unreachable-database (expected non-zero exit)"
else
  pass "site-unreachable-database (exits on bad DB)"
fi

# ==========================================================================
# Start Postgres (skip if already running)
# ==========================================================================
if pg_isready -h localhost -U devtrace -d devtrace >/dev/null 2>&1; then
  echo "==> Postgres already running"
else
  echo "==> Starting Postgres..."
  docker compose up -d || { echo "FAIL: docker compose up failed" >&2; exit 1; }
  STARTED_COMPOSE=true
  for i in $(seq 1 30); do
    pg_isready -h localhost -U devtrace -d devtrace >/dev/null 2>&1 && break
    sleep 1
  done
  pg_isready -h localhost -U devtrace -d devtrace >/dev/null 2>&1 || { echo "FAIL: Postgres not ready" >&2; exit 1; }
  echo "==> Postgres ready"
fi

# ==========================================================================
# Start site server
# ==========================================================================
echo "==> Starting devtrace-site on port $SITE_PORT..."
# GITHUB_TOKEN is required for startup but not used by e2e tests
# (bot detection, unauth scoring, and HTTP routing don't call GitHub API).
DATABASE_URL="$DEV_DB" PORT="$SITE_PORT" DEVTRACE_DEBUG=true BASE_URL="http://localhost:$SITE_PORT" \
  UNAUTH_RATE_LIMIT=100 \
  GITHUB_TOKEN="${GITHUB_TOKEN:-e2e-placeholder}" \
  "$SITE" >"$TMPDIR_E2E/site.log" 2>&1 &
SITE_PID=$!

for i in $(seq 1 15); do
  curl -sf "http://localhost:$SITE_PORT/health" >/dev/null 2>&1 && break
  sleep 1
done
curl -sf "http://localhost:$SITE_PORT/health" >/dev/null 2>&1 || { echo "FAIL: site not ready"; cat "$TMPDIR_E2E/site.log"; exit 1; }
echo "==> Site ready"

# ==========================================================================
# HTTP tests
# ==========================================================================

# Health endpoint
STATUS=$(curl -sf -o /dev/null -w "%{http_code}" "http://localhost:$SITE_PORT/health")
[[ "$STATUS" == "200" ]] && pass "GET /health → 200" || err "GET /health → $STATUS (expected 200)"

# Landing page
STATUS=$(curl -sf -o "$TMPDIR_E2E/landing.html" -w "%{http_code}" "http://localhost:$SITE_PORT/")
if [[ "$STATUS" == "200" ]] && grep -qi "devtrace" "$TMPDIR_E2E/landing.html"; then
  pass "GET / → 200 with DevTrace content"
else
  err "GET / → $STATUS (expected 200 with DevTrace)"
fi

# Help page
STATUS=$(curl -sf -o "$TMPDIR_E2E/help.html" -w "%{http_code}" "http://localhost:$SITE_PORT/help")
if [[ "$STATUS" == "200" ]]; then
  pass "GET /help → 200"
else
  err "GET /help → $STATUS (expected 200)"
fi

# Compliance page
STATUS=$(curl -sf -o "$TMPDIR_E2E/compliance.html" -w "%{http_code}" "http://localhost:$SITE_PORT/compliance")
if [[ "$STATUS" == "200" ]] && grep -qi "SSDF" "$TMPDIR_E2E/compliance.html"; then
  pass "GET /compliance → 200 with SSDF content"
else
  err "GET /compliance → $STATUS (expected 200 with SSDF)"
fi

# Unauthenticated /dashboard redirects to auth
STATUS=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:$SITE_PORT/dashboard")
[[ "$STATUS" == "302" ]] && pass "GET /dashboard (unauth) → 302" || err "GET /dashboard (unauth) → $STATUS (expected 302)"

# Unauthenticated /settings redirects to auth
STATUS=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:$SITE_PORT/settings")
[[ "$STATUS" == "302" ]] && pass "GET /settings (unauth) → 302" || err "GET /settings (unauth) → $STATUS (expected 302)"

# Static assets served
STATUS=$(curl -sf -o /dev/null -w "%{http_code}" "http://localhost:$SITE_PORT/static/css/app.css")
[[ "$STATUS" == "200" ]] && pass "GET /static/css/app.css → 200" || err "GET /static/css/app.css → $STATUS (expected 200)"

# Bot detection — score 0, no GitHub API call needed
STATUS=$(curl -sf -o "$TMPDIR_E2E/bot.json" -w "%{http_code}" "http://localhost:$SITE_PORT/api/v1/score/dependabot%5Bbot%5D")
if [[ "$STATUS" == "200" ]]; then
  BOT_SCORE=$(jq -r '.score.value' "$TMPDIR_E2E/bot.json")
  BOT_GRADE=$(jq -r '.score.grade' "$TMPDIR_E2E/bot.json")
  if [[ "$BOT_SCORE" == "0" ]] && [[ "$BOT_GRADE" == "F" ]]; then
    pass "bot detection: dependabot[bot] → score 0, grade F"
  else
    err "bot detection: score=$BOT_SCORE grade=$BOT_GRADE (expected 0/F)"
  fi
  # Verify version field present
  if jq -e '.version' "$TMPDIR_E2E/bot.json" >/dev/null 2>&1; then
    pass "bot response has version field"
  else
    err "bot response missing version field"
  fi
else
  err "GET /api/v1/score/dependabot[bot] → $STATUS (expected 200)"
fi

# Score API with real GitHub token — only run when GITHUB_TOKEN is a real token
if [[ "${GITHUB_TOKEN:-}" != "" ]] && [[ "${GITHUB_TOKEN}" != "e2e-placeholder" ]]; then
  STATUS=$(curl -sf -o "$TMPDIR_E2E/score.json" -w "%{http_code}" "http://localhost:$SITE_PORT/api/v1/score/octocat")
  if [[ "$STATUS" == "200" ]]; then
    if jq -e '.score.grade' "$TMPDIR_E2E/score.json" >/dev/null 2>&1; then
      pass "GET /api/v1/score/octocat → 200 with grade"
    else
      err "GET /api/v1/score/octocat → 200 but missing .score.grade"
    fi
  else
    err "GET /api/v1/score/octocat → $STATUS (expected 200)"
  fi
else
  echo "SKIP: score API test (no real GITHUB_TOKEN)"
fi

# Token management requires auth
STATUS=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:$SITE_PORT/api/v1/token")
[[ "$STATUS" == "302" ]] && pass "GET /api/v1/token (unauth) → 302" || err "GET /api/v1/token (unauth) → $STATUS (expected 302)"

# Webhook rejects without signature
STATUS=$(curl -s -o /dev/null -w "%{http_code}" -X POST "http://localhost:$SITE_PORT/webhook/github" -d '{}')
[[ "$STATUS" == "404" || "$STATUS" == "401" ]] && pass "POST /webhook/github (no secret configured) → $STATUS" || err "POST /webhook/github → $STATUS (expected 404 or 401)"

# ==========================================================================
# Public pages — coverage extension
# ==========================================================================

# Changelog
STATUS=$(curl -sf -o "$TMPDIR_E2E/changelog.html" -w "%{http_code}" "http://localhost:$SITE_PORT/changelog")
if [[ "$STATUS" == "200" ]] && grep -qi "changelog" "$TMPDIR_E2E/changelog.html"; then
  pass "GET /changelog → 200 with content"
else
  err "GET /changelog → $STATUS (expected 200 with changelog content)"
fi

# Terms of service
STATUS=$(curl -sf -o "$TMPDIR_E2E/tos.html" -w "%{http_code}" "http://localhost:$SITE_PORT/tos")
if [[ "$STATUS" == "200" ]] && grep -qi "terms" "$TMPDIR_E2E/tos.html"; then
  pass "GET /tos → 200 with terms content"
else
  err "GET /tos → $STATUS (expected 200 with terms)"
fi

# HTML scorecard for a bot — exercises /score/{username} without burning
# GitHub quota (bot detector short-circuits before any API call).
STATUS=$(curl -sf -o "$TMPDIR_E2E/scorecard.html" -w "%{http_code}" "http://localhost:$SITE_PORT/score/dependabot%5Bbot%5D")
if [[ "$STATUS" == "200" ]] && grep -qi "dependabot" "$TMPDIR_E2E/scorecard.html"; then
  pass "GET /score/dependabot[bot] → 200 with bot scorecard"
else
  err "GET /score/dependabot[bot] → $STATUS (expected 200 with bot HTML)"
fi

# Unknown route — Go's mux returns 404 for unmatched paths.
STATUS=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:$SITE_PORT/this/does/not/exist")
[[ "$STATUS" == "404" ]] && pass "GET unknown route → 404" || err "GET unknown route → $STATUS (expected 404)"

# Method not allowed — POST against a GET-only route surfaces 405 from mux.
STATUS=$(curl -s -o /dev/null -w "%{http_code}" -X POST "http://localhost:$SITE_PORT/health")
[[ "$STATUS" == "405" ]] && pass "POST /health → 405 (method not allowed)" || err "POST /health → $STATUS (expected 405)"

# JS static asset (the CSS test only covers one MIME type)
STATUS=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:$SITE_PORT/static/js/app.js")
# 200 if app.js exists, 404 if not — both are acceptable, just not 5xx.
[[ "$STATUS" == "200" || "$STATUS" == "404" ]] && pass "GET /static/js/app.js → $STATUS" || err "GET /static/js/app.js → $STATUS (expected 200 or 404)"

# ==========================================================================
# Security headers — recoverPanics and securityHeaders middleware
# ==========================================================================

HEADERS=$(curl -sf -D - -o /dev/null "http://localhost:$SITE_PORT/")
if echo "$HEADERS" | grep -qi "^X-Content-Type-Options: nosniff"; then
  pass "X-Content-Type-Options: nosniff present"
else
  err "X-Content-Type-Options header missing"
fi
if echo "$HEADERS" | grep -qi "^X-Frame-Options: DENY"; then
  pass "X-Frame-Options: DENY present"
else
  err "X-Frame-Options header missing"
fi
if echo "$HEADERS" | grep -qi "^Content-Security-Policy:.*style-src 'self'"; then
  pass "Content-Security-Policy locks style-src to 'self' (no unsafe-inline)"
else
  err "CSP missing or still allows 'unsafe-inline' on style-src"
fi
if echo "$HEADERS" | grep -qi "^Content-Security-Policy:.*style-src-attr 'unsafe-inline'"; then
  pass "CSP carves out style-src-attr for inline style attributes"
else
  err "CSP missing style-src-attr carve-out"
fi
if echo "$HEADERS" | grep -qi "^Referrer-Policy: strict-origin-when-cross-origin"; then
  pass "Referrer-Policy present"
else
  err "Referrer-Policy header missing"
fi
if echo "$HEADERS" | grep -qi "^Permissions-Policy:"; then
  pass "Permissions-Policy present"
else
  err "Permissions-Policy header missing"
fi

# ==========================================================================
# JSON error envelope shape
# ==========================================================================

# Score history — unauthenticated request accepted but rate-limited path; the
# response is JSON either way. Use bot username so no GH API call is made.
RESP=$(curl -s -o "$TMPDIR_E2E/history.json" -w "%{http_code}" "http://localhost:$SITE_PORT/api/v1/score/dependabot%5Bbot%5D/history")
if [[ "$RESP" == "200" ]]; then
  # Empty history is valid (bot has never been scored). Just confirm it
  # parsed as JSON and didn't return an HTML 500.
  if jq -e '.' "$TMPDIR_E2E/history.json" >/dev/null 2>&1; then
    pass "GET /api/v1/score/{bot}/history → 200 JSON"
  else
    err "GET /api/v1/score/{bot}/history → 200 but body not JSON"
  fi
elif [[ "$RESP" == "429" ]]; then
  pass "GET /api/v1/score/{bot}/history → 429 (rate-limited path)"
else
  err "GET /api/v1/score/{bot}/history → $RESP (expected 200 or 429)"
fi

# Digest unsubscribe — request with garbage token must reject, not 500.
STATUS=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:$SITE_PORT/digest/unsubscribe?tenant=nope&token=garbage")
[[ "$STATUS" == "400" || "$STATUS" == "401" || "$STATUS" == "403" || "$STATUS" == "404" ]] && pass "GET /digest/unsubscribe (bad token) → $STATUS (rejected, not 5xx)" || err "GET /digest/unsubscribe (bad token) → $STATUS (expected 4xx)"

# Digest unsubscribe — missing query params must reject as well.
STATUS=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:$SITE_PORT/digest/unsubscribe")
[[ "$STATUS" == "400" || "$STATUS" == "404" ]] && pass "GET /digest/unsubscribe (no params) → $STATUS" || err "GET /digest/unsubscribe (no params) → $STATUS (expected 400/404)"

# ==========================================================================
# Admin gate — non-admin users should get 404 (admins config'd via env)
# ==========================================================================

STATUS=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:$SITE_PORT/admin")
[[ "$STATUS" == "404" || "$STATUS" == "302" ]] && pass "GET /admin (no admin auth) → $STATUS (gated)" || err "GET /admin → $STATUS (expected 404 or 302)"

STATUS=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:$SITE_PORT/admin/tenants")
[[ "$STATUS" == "404" || "$STATUS" == "302" ]] && pass "GET /admin/tenants (no admin auth) → $STATUS (gated)" || err "GET /admin/tenants → $STATUS (expected 404 or 302)"

# ==========================================================================
# Panic recovery — sanity check that a normal request after a forced bad
# input still returns a clean response (proves middleware didn't crash the
# process). Use a path that exists but trigger a malformed query string.
# ==========================================================================

curl -s -o /dev/null "http://localhost:$SITE_PORT/api/v1/score/%00bad" || true
STATUS=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:$SITE_PORT/health")
[[ "$STATUS" == "200" ]] && pass "GET /health after malformed prior request → 200 (process intact)" || err "site appears unhealthy after bad input: $STATUS"

# ==========================================================================
# Summary
# ==========================================================================
echo ""
if [[ $FAILURES -gt 0 ]]; then
  echo "FAIL: $FAILURES test(s) failed" >&2
  exit 1
fi
echo "==> All e2e tests passed"
