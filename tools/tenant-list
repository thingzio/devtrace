#!/bin/bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${DIR}/common"

has_tools curl jq

API_URL="${API_URL:-http://localhost:8080}"
ADMIN_API_KEY="${ADMIN_API_KEY:?ADMIN_API_KEY is required}"

msg "Listing tenants..."
RESPONSE="$(curl -s -w "\n%{http_code}" \
    -H "Authorization: Bearer ${ADMIN_API_KEY}" \
    "${API_URL}/api/v1/admin/tenants")"

HTTP_CODE="$(echo "${RESPONSE}" | tail -1)"
BODY="$(echo "${RESPONSE}" | sed '$d')"

if [[ "${HTTP_CODE}" != "200" ]]; then
    err "Failed (HTTP ${HTTP_CODE}): ${BODY}"
fi

echo "${BODY}" | jq -r '
    ["USERNAME", "PLAN", "STATUS", "MAX_CONTRIB", "CREATED"],
    (.tenants[] | [
        .username,
        .plan,
        .status,
        (.max_contributors | tostring),
        (.created_at[:10])
    ]) | @tsv' | column -t -s $'\t'
